@@ -0,0 +1,426 @@
+/* ==========================================================================
+   Studio "Opal" look: a polished dark-first theme with glass surfaces and a
+   violet → magenta → coral accent (matching the logo). Loaded last, so it
+   sits on top of styles.css / theme.css. Light mode keeps the same language.
+   ========================================================================== */
+
+/* ---------- Tokens: dark is the default ---------- */
+html:root,
+html:root[data-theme='dark'] {
+  --bg: #07070a;
+  --bg2: #0c0c11;
+  --surface: #121218;
+  --surface2: #1a1a22;
+  --surface3: #22222c;
+  --sbbg: rgba(14, 14, 19, 0.82);
+  --ink: #f4f4f7;
+  --ink2: #c9c9d3;
+  --muted: #8a8a99;
+  --line: rgba(255, 255, 255, 0.07);
+  --line2: rgba(255, 255, 255, 0.12);
+  --accent: #a78bfa;
+  --accent-d: #c4b5fd;
+  --accent2: #f472b6;
+  --soft: rgba(139, 92, 246, 0.14);
+  --mid: #8b5cf6;
+  --light: rgba(167, 139, 250, 0.35);
+  --on: #ffffff;
+  --amber: #fbbf24;
+  --danger: #f87171;
+  --ok: #34d399;
+  --grad: linear-gradient(135deg, #7c5cff 0%, #b44bff 52%, #ff5f8f 100%);
+  --grad-soft: linear-gradient(135deg, rgba(124, 92, 255, 0.18), rgba(180, 75, 255, 0.12) 52%, rgba(255, 95, 143, 0.14));
+  --glass: rgba(20, 20, 27, 0.66);
+  --glass-line: rgba(255, 255, 255, 0.08);
+  --glow: 0 0 0 1px rgba(167, 139, 250, 0.35), 0 8px 40px -8px rgba(139, 92, 246, 0.45);
+  --shadow: 0 10px 30px -12px rgba(0, 0, 0, 0.7), 0 1px 0 rgba(255, 255, 255, 0.03) inset;
+  --shadow-lg: 0 24px 70px -20px rgba(0, 0, 0, 0.85);
+  --ok-bg: rgba(52, 211, 153, 0.12);
+  --bad-bg: rgba(248, 113, 113, 0.12);
+  --warn-bg: rgba(251, 191, 36, 0.12);
+  --info-bg: rgba(96, 165, 250, 0.12);
+  --sans: 'Inter', system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
+  --head: 'Inter', system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
+  color-scheme: dark;
+}
+
+@media (prefers-color-scheme: light) {
+  html:root:not([data-theme]) {
+    --bg: #f6f6fa; --bg2: #eeeef5; --surface: #ffffff; --surface2: #f1f1f7; --surface3: #e8e8f1; --sbbg: rgba(250, 250, 253, 0.85);
+    --ink: #121218; --ink2: #3c3c48; --muted: #6e6e7e; --line: rgba(18, 18, 40, 0.08); --line2: rgba(18, 18, 40, 0.14);
+    --accent: #7c3aed; --accent-d: #6d28d9; --accent2: #db2777; --soft: rgba(124, 58, 237, 0.09); --mid: #8b5cf6; --light: rgba(124, 58, 237, 0.25);
+    --glass: rgba(255, 255, 255, 0.72); --glass-line: rgba(18, 18, 40, 0.08);
+    --glow: 0 0 0 1px rgba(124, 58, 237, 0.3), 0 10px 36px -10px rgba(124, 58, 237, 0.35);
+    --shadow: 0 10px 30px -14px rgba(30, 20, 80, 0.22); --shadow-lg: 0 28px 70px -24px rgba(30, 20, 80, 0.3);
+    --ok: #059669; --danger: #dc2626; --amber: #b45309;
+    --ok-bg: #e7f8f0; --bad-bg: #fdeceb; --warn-bg: #fff6df; --info-bg: #e9f1fe;
+    color-scheme: light;
+  }
+}
+html:root[data-theme='light'] {
+  --bg: #f6f6fa; --bg2: #eeeef5; --surface: #ffffff; --surface2: #f1f1f7; --surface3: #e8e8f1; --sbbg: rgba(250, 250, 253, 0.85);
+  --ink: #121218; --ink2: #3c3c48; --muted: #6e6e7e; --line: rgba(18, 18, 40, 0.08); --line2: rgba(18, 18, 40, 0.14);
+  --accent: #7c3aed; --accent-d: #6d28d9; --accent2: #db2777; --soft: rgba(124, 58, 237, 0.09); --mid: #8b5cf6; --light: rgba(124, 58, 237, 0.25);
+  --glass: rgba(255, 255, 255, 0.72); --glass-line: rgba(18, 18, 40, 0.08);
+  --glow: 0 0 0 1px rgba(124, 58, 237, 0.3), 0 10px 36px -10px rgba(124, 58, 237, 0.35);
+  --shadow: 0 10px 30px -14px rgba(30, 20, 80, 0.22); --shadow-lg: 0 28px 70px -24px rgba(30, 20, 80, 0.3);
+  --ok: #059669; --danger: #dc2626; --amber: #b45309;
+  --ok-bg: #e7f8f0; --bad-bg: #fdeceb; --warn-bg: #fff6df; --info-bg: #e9f1fe;
+  color-scheme: light;
+}
+
+/* ---------- Base ---------- */
+html body {
+  background: var(--bg);
+  color: var(--ink);
+  font-family: var(--sans);
+  font-size: 15px;
+  letter-spacing: -0.011em;
+  -webkit-font-smoothing: antialiased;
+  -moz-osx-font-smoothing: grayscale;
+}
+/* Soft aurora behind everything */
+html body::before {
+  content: '';
+  position: fixed;
+  inset: 0;
+  pointer-events: none;
+  z-index: 0;
+  background:
+    radial-gradient(900px 520px at 85% -10%, rgba(124, 92, 255, 0.16), transparent 60%),
+    radial-gradient(700px 480px at -10% 110%, rgba(255, 95, 143, 0.09), transparent 60%),
+    radial-gradient(600px 400px at 50% 120%, rgba(180, 75, 255, 0.07), transparent 60%);
+}
+html:root[data-theme='light'] body::before { opacity: 0.55; }
+@media (prefers-color-scheme: light) { html:root:not([data-theme]) body::before { opacity: 0.55; } }
+html #root { position: relative; z-index: 1; }
+html ::selection { background: rgba(167, 139, 250, 0.35); color: inherit; }
+html :focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; border-radius: 8px; }
+html * { scrollbar-width: thin; scrollbar-color: var(--line2) transparent; }
+html ::-webkit-scrollbar { width: 10px; height: 10px; }
+html ::-webkit-scrollbar-thumb { background: var(--line2); border-radius: 99px; border: 3px solid transparent; background-clip: padding-box; }
+html ::-webkit-scrollbar-track { background: transparent; }
+html .hint { color: var(--muted); font-size: 13px; line-height: 1.5; }
+html .label { color: var(--muted); font-size: 12px; font-weight: 600; letter-spacing: 0.02em; text-transform: none; margin-bottom: 6px; display: block; }
+html .mono { font-family: var(--mono); }
+
+/* ---------- Buttons ---------- */
+html .btn {
+  min-height: 40px;
+  padding: 0 16px;
+  border: 1px solid var(--line2);
+  border-radius: 12px;
+  background: var(--surface2);
+  color: var(--ink);
+  font-size: 14px;
+  font-weight: 600;
+  transition: background 0.15s, border-color 0.15s, transform 0.08s, box-shadow 0.2s;
+}
+html .btn:hover:not(:disabled) { background: var(--surface3); border-color: var(--line2); }
+html .btn:active:not(:disabled) { transform: translateY(1px); }
+html .btn.primary {
+  background: var(--grad);
+  border-color: transparent;
+  color: #fff;
+  box-shadow: 0 8px 24px -10px rgba(139, 92, 246, 0.75), inset 0 1px 0 rgba(255, 255, 255, 0.22);
+}
+html .btn.primary:hover:not(:disabled) { background: var(--grad); filter: brightness(1.08); box-shadow: 0 10px 30px -10px rgba(180, 75, 255, 0.85), inset 0 1px 0 rgba(255, 255, 255, 0.25); }
+html .btn.ghost { background: transparent; border-color: transparent; color: var(--muted); }
+html .btn.ghost:hover:not(:disabled) { background: var(--surface2); color: var(--ink); }
+html .btn.danger { color: var(--danger); background: transparent; border-color: color-mix(in srgb, var(--danger) 35%, transparent); }
+html .btn.danger:hover:not(:disabled) { background: var(--bad-bg); }
+html .btn.small { min-height: 32px; padding: 0 12px; font-size: 13px; border-radius: 10px; }
+html .btn:disabled { opacity: 0.45; }
+html .icon-btn { border-radius: 10px; color: var(--muted); transition: background 0.15s, color 0.15s; }
+html .icon-btn:hover:not(:disabled) { background: var(--surface2); color: var(--ink); }
+
+/* ---------- Inputs ---------- */
+html .field,
+html .settings input[type='number'],
+html .table input {
+  min-height: 42px;
+  border: 1px solid var(--line2);
+  border-radius: 12px;
+  background: var(--bg2);
+  color: var(--ink);
+  transition: border-color 0.15s, box-shadow 0.15s, background 0.15s;
+}
+html .field::placeholder { color: color-mix(in srgb, var(--muted) 75%, transparent); }
+html .field:focus,
+html .table input:focus { outline: none; border-color: color-mix(in srgb, var(--accent) 70%, transparent); box-shadow: 0 0 0 4px color-mix(in srgb, var(--accent) 18%, transparent); background: var(--surface); }
+html select.field { appearance: none; background-image: linear-gradient(45deg, transparent 50%, var(--muted) 50%), linear-gradient(135deg, var(--muted) 50%, transparent 50%); background-position: calc(100% - 18px) 52%, calc(100% - 13px) 52%; background-size: 5px 5px; background-repeat: no-repeat; padding-right: 34px; }
+html input[type='checkbox'] { accent-color: var(--mid); width: 16px; height: 16px; }
+
+/* ---------- Banners ---------- */
+html .banner { border: 1px solid var(--line); background: var(--surface2); color: var(--ink2); border-radius: 12px; }
+html .banner.error { background: var(--bad-bg); border-color: color-mix(in srgb, var(--danger) 30%, transparent); color: var(--danger); }
+html .banner.note { background: var(--warn-bg); border-color: color-mix(in srgb, var(--amber) 30%, transparent); color: var(--ink); }
+html .banner.info { background: var(--soft); border-color: var(--light); color: var(--ink); }
+html .banner.ok { background: var(--ok-bg); border-color: color-mix(in srgb, var(--ok) 30%, transparent); color: var(--ok); }
+
+/* ---------- Shell: sidebar + main ---------- */
+html .app { background: transparent; }
+html .sidebar {
+  flex-basis: 268px;
+  padding: 14px 12px 12px;
+  background: var(--sbbg);
+  backdrop-filter: blur(22px) saturate(140%);
+  -webkit-backdrop-filter: blur(22px) saturate(140%);
+  border-right: 1px solid var(--glass-line);
+}
+html .sb-top { padding: 2px 4px 8px; }
+html .sb-brand { font-size: 18px; font-weight: 700; letter-spacing: -0.03em; gap: 10px; }
+html .sb-brand svg { filter: drop-shadow(0 4px 14px rgba(180, 75, 255, 0.45)); }
+html .sb-new {
+  min-height: 42px;
+  padding: 0 12px;
+  margin: 2px 0 6px;
+  border: 1px solid var(--line2);
+  border-radius: 12px;
+  background: var(--grad-soft);
+  font-size: 14px;
+  font-weight: 600;
+  transition: border-color 0.15s, box-shadow 0.2s;
+}
+html .sb-new:hover { border-color: var(--light); box-shadow: var(--glow); background: var(--grad-soft); }
+html .sb-plus { width: 24px; height: 24px; border-radius: 8px; display: inline-flex; align-items: center; justify-content: center; background: var(--grad); color: #fff; box-shadow: 0 4px 12px -4px rgba(180, 75, 255, 0.8); }
+html .sb-nav { gap: 2px; }
+html .sb-nav button { min-height: 38px; border-radius: 10px; font-size: 14px; font-weight: 500; color: var(--ink2); gap: 11px; padding: 0 10px; transition: background 0.15s, color 0.15s; }
+html .sb-nav button svg { color: var(--muted); transition: color 0.15s; }
+html .sb-nav button:hover { background: var(--surface2); color: var(--ink); }
+html .sb-nav button.on { background: var(--surface2); color: var(--ink); box-shadow: inset 0 0 0 1px var(--line); position: relative; }
+html .sb-nav button.on svg { color: var(--accent); }
+html .sb-nav button.on::before { content: ''; position: absolute; left: -12px; top: 9px; bottom: 9px; width: 3px; border-radius: 0 3px 3px 0; background: var(--grad); }
+html .sb-title { color: var(--muted); font-size: 11px; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; padding: 16px 10px 6px; }
+html .sb-item { border-radius: 10px; }
+html .sb-item button.go { color: var(--ink2); font-weight: 450; }
+html .sb-item:hover { background: var(--surface2); }
+html .sb-item.on { background: var(--soft); }
+html .sb-item.on button.go { color: var(--ink); font-weight: 550; }
+html .sb-foot { padding-top: 8px; border-top: 1px solid var(--line); margin-top: 4px; }
+html .sb-user { border-radius: 12px; }
+html .sb-user:hover { background: var(--surface2); }
+html .avatar { background: var(--grad); color: #fff; font-weight: 700; box-shadow: 0 4px 14px -6px rgba(180, 75, 255, 0.8); }
+html .main { background: transparent; }
+html .topbar { min-height: 56px; padding: 10px 18px; border-bottom: 1px solid transparent; }
+html .topbar .title { font-weight: 600; font-size: 14.5px; color: var(--ink2); letter-spacing: -0.01em; }
+html .app.m .topbar { background: var(--glass); backdrop-filter: blur(18px); -webkit-backdrop-filter: blur(18px); border-bottom-color: var(--glass-line); }
+html .scrim.show { background: rgba(0, 0, 0, 0.55); backdrop-filter: blur(2px); }
+
